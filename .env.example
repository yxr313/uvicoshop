# ===========================
# UVICO — Variables de Entorno
# ===========================
# Copia este archivo a .env y rellena con tus valores.
# NUNCA commitees .env al repositorio.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Base de Datos Directa (para Go) ---
DATABASE_URL=
DATABASE_POOL_URL=

# --- Redis (Upstash / Dragonfly) ---
REDIS_URL=
REDIS_TOKEN=

# --- BCV (Tasa de cambio) ---
BCV_API_URL=
BCV_API_KEY=

# --- Pasarelas de Pago (Venezuela) ---
# Suscripciones UVICO (credenciales de UVICO, no de comercios)
UVICO_WAYU_API_KEY=
UVICO_WAYU_MERCHANT_ID=
UVICO_VERIPAY_API_KEY=
UVICO_VERIPAY_MERCHANT_ID=

# --- Cifrado (tokens de comercios, datos sensibles) ---
ENCRYPTION_KEY=

# --- URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Observabilidad ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Email ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=hola@uvico.shop

# --- Web Push ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
