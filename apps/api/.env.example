# --- Entorno ---
APP_ENV=development
SERVICE_NAME=uvico-api
SERVICE_VERSION=0.1.0
SERVICE_REGION=local
LOG_LEVEL=debug

# --- HTTP ---
PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=25s
SERVER_BASE_PATH=/v1

# --- Postgres (Supabase) ---
DATABASE_URL=postgres://postgres.[ref]:[pass]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
MIGRATIONS_URL=postgres://postgres.[ref]:[pass]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DB_SSL_MODE=require
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK=1m
DB_CONNECT_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=5s

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=50
REDIS_MIN_IDLE_CONNS=10
REDIS_DIAL_TIMEOUT=3s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_CART_TTL=15m
REDIS_BCV_CACHE_TTL=1h
REDIS_LOCK_TTL=10s

# --- Supabase ---
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Auth ---
AUTH_JWT_ISSUER=uvico
AUTH_JWT_AUDIENCE=uvico-api
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=168h

# --- Pasarelas de Pago ---
WAYU_BASE_URL=https://api.wayu.io
WAYU_API_KEY=
WAYU_WEBHOOK_SECRET=
WAYU_TIMEOUT=10s
WAYU_MAX_RETRIES=3
VERIPAY_BASE_URL=https://api.veripay.io
VERIPAY_API_KEY=
VERIPAY_WEBHOOK_SECRET=
VERIPAY_TIMEOUT=10s
VERIPAY_MAX_RETRIES=3

# --- BCV ---
BCV_SCRAPER_URL=https://www.bcv.org.ve/
BCV_SCRAPER_CRON=0 * * * *
BCV_HTTP_TIMEOUT=10s
BCV_CACHE_TTL=1h

# --- Observabilidad ---
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=uvico-api
OTEL_SAMPLE_RATE=0.1
SENTRY_DSN=
METRICS_PORT=9090

# --- Seguridad ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
RATE_LIMIT_REDIS_KEY=uvico:rl
ENFORCE_HTTPS=false

# --- Planes (centavos/mes) ---
PLAN_FOUNDER_MONTHLY_CENTS=900
PLAN_FOUNDER_TRIAL_CENTS=100
PLAN_ESSENTIAL_MONTHLY_CENTS=1999
PLAN_PROFESSIONAL_MONTHLY_CENTS=4999
PLAN_ENTERPRISE_MONTHLY_CENTS=9999
PLAN_ANNUAL_DISCOUNT_BPS=8300

# --- Custodia y Payouts ---
UVICO_COMMISSION_BPS=500
GATEWAY_FEE_DEFAULT_BPS=350
PROVIDER_COST_DEFAULT_BPS=5000
PAYOUT_WEEKLY_DOW=5
PAYOUT_FORTNIGHTLY_DOW=5
PAYOUT_MIN_CENTS=1000

# --- Multi-tenancy ---
DEFAULT_TENANT_ID=
ENFORCE_TENANT_ISOLATION=true
TENANT_HEADER=X-Tenant-ID

# MVP: false (dropshipping bloqueado). Activar cuando llegue Wayu.
CUSTODY_ENABLED=false